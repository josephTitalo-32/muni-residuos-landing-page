---
import Layout from '../../layouts/Layout.astro';
import { Header } from '../../components/Header';
import { Footer } from '../../components/Footer';
import { NEWS_DATA } from '../../data/newsData';
import { 
  ArrowLeft, 
  Calendar, 
  Clock, 
  Tag, 
  Building2, 
  ShieldCheck,
  ArrowRight
} from 'lucide-react';

// Astro: generar una página estática por cada noticia del array
export function getStaticPaths() {
  return NEWS_DATA.map((news) => ({
    params: { id: news.id },
    props: { news },
  }));
}

const { news } = Astro.props;

const getCategoryBadgeClass = (category: string) => {
  switch (category) {
    case 'Intervención':
      return 'bg-[#E6F2FA] text-[#0B335E] border-[#0081C0]/30';
    case 'Campaña':
      return 'bg-[#F0FDF4] text-[#15803D] border-[#15803D]/30';
    case 'Logro':
      return 'bg-[#E6F2FA] text-[#0B335E] border-[#0081C0]/30';
    case 'Anuncio Oficial':
      return 'bg-[#FEF7E6] text-[#78350F] border-[#E5A91E]/40';
    default:
      return 'bg-slate-100 text-slate-700 border-slate-200';
  }
};

// Otras noticias (excluyendo la actual)
const otherNews = NEWS_DATA.filter((n) => n.id !== news.id).slice(0, 3);
---

<Layout title={`${news.title} - Muni Puno Digital`} description={news.excerpt}>
  <div class="min-h-screen bg-[#F8FAFC] text-[#0F172A] flex flex-col selection:bg-[#0081C0] selection:text-white">
    
    <Header client:only="react" />

    <main class="flex-1 pt-20 sm:pt-24 pb-20 relative overflow-hidden">
      
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        {/* Botón volver */}
        <div class="flex flex-wrap items-center gap-3 mb-6 sm:mb-8">
            <a
              href="/#actualidad"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-white border border-slate-200 hover:border-[#0081C0]/40 hover:text-[#0081C0] text-xs font-bold text-[#0B335E] shadow-2xs transition-all font-heading group"
            >
              <ArrowLeft class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" />
              <span>Volver</span>
            </a>
        </div>

        {/* Artículo */}
        <article class="bg-white rounded-3xl border border-slate-200/90 shadow-xs overflow-hidden animate-pop-in">
          
          {/* Imagen grande */}
          <div class="relative w-full h-64 sm:h-80 md:h-[380px] bg-slate-100 overflow-hidden">
            <img
              src={news.image}
              alt={news.title}
              class="w-full h-full object-cover"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
            
            <div class="absolute top-4 left-4 sm:top-6 sm:left-6">
              <span class={`px-4 py-1.5 rounded-full text-xs font-extrabold uppercase tracking-wider border backdrop-blur-md shadow-sm font-heading ${getCategoryBadgeClass(news.category)}`}>
                {news.category}
              </span>
            </div>
          </div>

          {/* Encabezado y contenido */}
          <div class="p-6 sm:p-10 space-y-6 sm:space-y-8">
            
            {/* Metadatos */}
            <div class="flex flex-wrap items-center gap-3 sm:gap-4 text-xs sm:text-sm text-slate-500 font-body border-b border-slate-100 pb-4">
              <div class="flex items-center gap-1.5 text-[#0B335E] font-semibold">
                <Calendar class="w-4 h-4 text-[#0081C0]" />
                <span>{news.date}</span>
              </div>
              <span>•</span>
              <div class="flex items-center gap-1.5 text-slate-500">
                <Clock class="w-4 h-4 text-[#0081C0]" />
                <span>{news.readTime}</span>
              </div>
            </div>

            {/* Título */}
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#0B335E] leading-tight tracking-tight font-heading">
              {news.title}
            </h1>

            {/* Autoría */}
            <div class="flex items-center gap-3.5 p-4 rounded-2xl bg-slate-50/80 border border-slate-200/80 text-xs sm:text-sm">
              <div class="w-10 h-10 rounded-xl bg-[#E6F2FA] flex items-center justify-center text-[#0081C0] shrink-0 border border-[#0081C0]/30">
                <Building2 class="w-5 h-5" />
              </div>
              <div>
                <div class="font-extrabold text-[#0B335E] font-heading">{news.author}</div>
                <div class="text-[11px] text-slate-500 font-body">Publicación institucional oficial verificada</div>
              </div>
            </div>

            {/* Contenido completo */}
            <div class="space-y-5 text-base sm:text-lg text-slate-700 leading-relaxed font-body pt-2">
              {news.fullContent.map((paragraph) => (
                <p class="leading-relaxed">{paragraph}</p>
              ))}
            </div>

            {/* Tags */}
            <div class="pt-6 border-t border-slate-100 flex flex-wrap items-center gap-2 font-body">
              <span class="inline-flex items-center gap-1 text-xs font-bold text-[#0B335E] uppercase tracking-wider font-heading mr-2">
                <Tag class="w-3.5 h-3.5 text-[#0081C0]" />
                Temas relacionados:
              </span>
              {news.tags.map((tag) => (
                <span class="px-3.5 py-1 rounded-full bg-slate-100 text-xs font-semibold text-[#0B335E] border border-slate-200/60 hover:bg-[#E6F2FA] hover:text-[#0081C0] transition-colors">
                  #{tag}
                </span>
              ))}
            </div>

          </div>

          {/* Sello institucional */}
          <div class="mx-6 sm:mx-10 mb-8 p-5 rounded-2xl bg-[#E6F2FA]/60 border border-[#0081C0]/30 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 font-body">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-white flex items-center justify-center text-[#0081C0] shrink-0 border border-[#0081C0]/30">
                <ShieldCheck class="w-5 h-5" />
              </div>
              <div>
                <p class="text-xs sm:text-sm font-bold text-[#0B335E]">
                  Contenido oficial verificado y administrado exclusivamente por la GGIRS • Municipalidad Provincial de Puno.
                </p>
                <p class="text-xs text-slate-500 font-body">
                  Publicado bajo estándares de gobierno digital y transparencia pública municipal.
                </p>
              </div>
            </div>
            <div class="shrink-0 self-start sm:self-center">
              <span class="inline-flex items-center px-3.5 py-1.5 rounded-full text-xs font-bold bg-[#0B335E] text-white font-heading shadow-xs">
                Resolución N° 082-2026-MPP
              </span>
            </div>
          </div>

        </article>

        {/* Otras noticias */}
        {otherNews.length > 0 && (
          <div class="mt-12 space-y-4">
            <h3 class="text-lg font-extrabold text-[#0B335E] font-heading tracking-tight">
              Otras Actualizaciones Institucionales
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              {otherNews.map((item) => (
                <a
                  href={`/noticias/${item.id}`}
                  class="bg-white rounded-2xl border border-slate-200/90 p-5 hover:border-[#0081C0]/50 hover:shadow-md transition-all cursor-pointer space-y-2 group shadow-2xs block"
                >
                  <div class="text-[11px] text-[#0081C0] font-bold font-heading">
                    {item.category} • {item.date}
                  </div>
                  <h4 class="text-xs sm:text-sm font-extrabold text-[#0B335E] group-hover:text-[#0081C0] transition-colors line-clamp-2 font-heading">
                    {item.title}
                  </h4>
                  <div class="flex items-center gap-1 text-[11px] text-[#0081C0] font-bold pt-1">
                    <span>Leer</span>
                    <ArrowRight class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" />
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

      </div>
    </main>

    <Footer />

  </div>
</Layout>