---
import 'leaflet/dist/leaflet.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Módulo de Gestión Integral de Residuos Sólidos - Muni Puno Digital',
  description = 'Plataforma institucional de gestión de residuos sólidos, consulta de las 29 rutas de recolección, segregación en la fuente, reportes vecinales y programa de compostaje de la Municipalidad Provincial de Puno.',
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body class="bg-[#F8FAFC] text-[#0F172A] font-sans antialiased selection:bg-[#0081C0] selection:text-white">
    <!-- Custom scrollbar overlay -->
    <div id="custom-scrollbar-track" class="custom-scrollbar-track">
      <div id="custom-scrollbar-thumb" class="custom-scrollbar-thumb"></div>
    </div>

    <slot />

    <script>
      // ============================================
      // CUSTOM SCROLLBAR OVERLAY
      // ============================================
      (function () {
        var track = document.getElementById('custom-scrollbar-track');
        var thumb = document.getElementById('custom-scrollbar-thumb');
        if (!track || !thumb) return;

        var hideTimeout = null;
        var isDragging = false;

        function updateThumb() {
          var scrollTop = window.scrollY || document.documentElement.scrollTop;
          var scrollHeight = document.documentElement.scrollHeight;
          var clientHeight = window.innerHeight;
          var scrollableHeight = scrollHeight - clientHeight;

          // Si no hay scroll posible, oculta el scrollbar
          if (scrollableHeight <= 0) {
            track.classList.remove('visible');
            return;
          }

          // Calcular altura del thumb proporcional
          var thumbHeight = Math.max(
            40,
            (clientHeight / scrollHeight) * clientHeight
          );

          // Calcular posición del thumb
          var thumbTop =
            (scrollTop / scrollableHeight) * (clientHeight - thumbHeight);

          thumb.style.height = thumbHeight + 'px';
          thumb.style.top = thumbTop + 'px';
        }

        function showScrollbar() {
          track.classList.add('visible');

          if (hideTimeout) {
            clearTimeout(hideTimeout);
          }

          hideTimeout = window.setTimeout(function () {
            if (!isDragging) {
              track.classList.remove('visible');
            }
          }, 1200);
        }

        // Escuchar scroll para mostrar y actualizar
        window.addEventListener('scroll', function () {
          updateThumb();
          showScrollbar();
        }, { passive: true });

        window.addEventListener('resize', updateThumb, { passive: true });

        // Mostrar también al mover el mouse por la zona derecha
        document.addEventListener('mousemove', function (e) {
          if (window.innerWidth - e.clientX < 30) {
            showScrollbar();
          }
        });

        // Drag del thumb
        thumb.addEventListener('mousedown', function (e) {
          e.preventDefault();
          isDragging = true;
          thumb.classList.add('dragging');
          document.body.style.userSelect = 'none';

          var startY = e.clientY;
          var startScrollTop = window.scrollY;

          function onMouseMove(moveEvent) {
            var deltaY = moveEvent.clientY - startY;
            var scrollHeight = document.documentElement.scrollHeight;
            var clientHeight = window.innerHeight;
            var scrollableHeight = scrollHeight - clientHeight;
            var trackHeight = clientHeight;

            var thumbHeight = Math.max(40, (clientHeight / scrollHeight) * clientHeight);
            var draggableHeight = trackHeight - thumbHeight;

            var scrollDelta = (deltaY / draggableHeight) * scrollableHeight;
            window.scrollTo(0, startScrollTop + scrollDelta);
          }

          function onMouseUp() {
            isDragging = false;
            thumb.classList.remove('dragging');
            document.body.style.userSelect = '';
            document.removeEventListener('mousemove', onMouseMove);
            document.removeEventListener('mouseup', onMouseUp);
          }

          document.addEventListener('mousemove', onMouseMove);
          document.addEventListener('mouseup', onMouseUp);
        });

        // Inicializar
        updateThumb();
      })();
    </script>
  </body>
</html>